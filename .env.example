# Reference configuration. The application reads environment variables directly;
# this file is not loaded automatically. Never put real values in this file.

# --- Chatbot --------------------------------------------------------------
# Who answers: openai (the default), gemini, or fake.
# Set RAG_PROVIDER=gemini when using Gemini. Set RAG_PROVIDER=fake only for
# local development without a model API key.
RAG_PROVIDER=openai

# Add the key for the selected provider.
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Models ---------------------------------------------------------------
# Defaults live in app/core/config.py. Set these only to override a default.
CHAT_MODEL=
JUDGE_MODEL=
EMBEDDING_MODEL=

# Where to keep embedding vectors between runs. Empty means no cache, which is
# right for the app. Set it before running the eval, which otherwise re-embeds
# the same 102 frozen events every time:
#   EMBEDDING_CACHE_PATH=app/test/fixtures/.embeddings
EMBEDDING_CACHE_PATH=

# --- Database -------------------------------------------------------------
# The image must have pgvector available; a stock postgres image cannot run
# migration 0004.
DATABASE_USER=app
DATABASE_PASS=app
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=db

# --- Sessions and tokens --------------------------------------------------
# Signs the JWTs and the OAuth session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
COOKIE_SECURE=true
# Comma-separated addresses allowed to review submissions, for example:
# EVENT_ADMIN_EMAILS=you@example.com
EVENT_ADMIN_EMAILS=
EVENT_SUBMISSION_DAILY_LIMIT=3

# --- OAuth ----------------------------------------------------------------
# Each provider needs both halves or it gets no button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# What the app calls "today" when it goes looking for events. Leave empty for
# the real date, which is what anything deployed wants.
#
# A local run wants the opposite. The demo events loaded by `python -m
# app.demo_seed` run from 2026-09-02 to 2026-11-12, so a clone started outside
# that window searches a calendar it has already walked past and every question
# comes back empty. Setting this to a day inside the window gives the chat UI
# something to find.
DEMO_DATE=
