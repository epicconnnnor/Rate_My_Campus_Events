# Copy to .env and fill in. .env is gitignored; this file is not, so never put
# a real value in here.

# --- Gemini ---------------------------------------------------------------
# Embeddings and chat. In CI this comes from the GEMINI_API_KEY repository
# secret instead.
# Needed when RAG_PROVIDER is gemini.
GEMINI_API_KEY=

# Set to "fake" to run the indexer and chat against a deterministic local
# stand-in, with no key and no network. Useless for real answers.
RAG_PROVIDER=

# --- Models ---------------------------------------------------------------
# Defaults live in app/core/config.py; set these only to override. They default
# to the Flash-Lite models because the free tier gives those 500 requests a day
# against 20 for the others.
# Keep JUDGE_MODEL different from CHAT_MODEL: quotas are per project per model,
# so a separate model gives the eval's judge its own daily allowance.
CHAT_MODEL=
JUDGE_MODEL=
EMBEDDING_MODEL=

# Who answers: openai (default), gemini, or fake. Each needs its own key, and
# only the selected one is imported, so the other SDK being installed costs
# nothing. Switching is this variable plus a key -- no model ids to remember,
# because the defaults follow the provider.
RAG_PROVIDER=

# Needed when RAG_PROVIDER is openai, which is the default.
OPENAI_API_KEY=

# Where to keep embedding vectors between runs. Empty means no cache, which is
# right for the app. Set it before running the eval, which otherwise re-embeds
# the same 102 frozen events every time:
#   EMBEDDING_CACHE_PATH=app/test/fixtures/.embeddings
EMBEDDING_CACHE_PATH=

# --- Database -------------------------------------------------------------
# The image must have pgvector available; a stock postgres image cannot run
# migration 0004.
DATABASE_USER=
DATABASE_PASS=
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=

# --- Sessions and tokens --------------------------------------------------
# Signs the JWTs and the OAuth session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- OAuth ----------------------------------------------------------------
# Each provider needs both halves or it gets no button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# What the app calls "today" when it goes looking for events. Leave empty for
# the real date, which is what anything deployed wants.
#
# A local run wants the opposite. The demo events loaded by `python -m
# app.demo_seed` run from 2026-09-02 to 2026-11-12, so a clone started outside
# that window searches a calendar it has already walked past and every question
# comes back empty. Setting this to a day inside the window gives the chat UI
# something to find.
DEMO_DATE=
