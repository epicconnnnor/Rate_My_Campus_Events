# Copy to .env and fill in. .env is gitignored; this file is not, so never put
# a real value in here.

# --- Gemini ---------------------------------------------------------------
# Embeddings and chat. In CI this comes from the GEMINI_API_KEY repository
# secret instead.
GEMINI_API_KEY=

# Set to "fake" to run the indexer and chat against a deterministic local
# stand-in, with no key and no network. Useless for real answers.
RAG_PROVIDER=

# --- Database -------------------------------------------------------------
# The image must have pgvector available; a stock postgres image cannot run
# migration 0004.
DATABASE_USER=
DATABASE_PASS=
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=

# --- Sessions and tokens --------------------------------------------------
# Signs the JWTs and the OAuth session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- OAuth ----------------------------------------------------------------
# Each provider needs both halves or it gets no button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
